{
  "name": "kindledash",
  "version": "0.1.0",
  "description": "Kindle Paperwhite 管理器 — 书库管理 / 屏幕镜像 / 性能监控 / 进程线程 / 文件管理 / 远程终端 / 垃圾清理",
  "main": "out/main/index.js",
  "author": "IceThunder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceThunder/kindledash.git"
  },
  "bugs": {
    "url": "https://github.com/IceThunder/kindledash/issues"
  },
  "homepage": "https://github.com/IceThunder/kindledash#readme",
  "private": false,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64",
    "dist:win": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.11.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.icethunder.kindledash.mac",
    "productName": "KindleDash",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "Apple Development: tl_kid@hotmail.com (4FWBTZLHXU)",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "KindleDash 需要访问本地网络以通过 SSH 连接局域网中的 Kindle 设备。",
        "NSBonjourServices": ["_ssh._tcp", "_services._dns-sd._udp"]
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
